<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-to-device transfer (API 31+, where `allowBackup="false"`
  no longer stops D2D on every vendor).

  The secure store (flutter_secure_storage's shared preferences) and the
  app-private files are bound to this install's Keystore: the master key can
  only be unwrapped by the Keystore key that sealed it, and Keystore keys
  never migrate. Carrying the blobs to a new device would only reproduce
  S27's broken store instead of the clean re-pair a new phone should get. So
  both are excluded everywhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="skidsense/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="skidsense/" />
    </device-transfer>
</data-extraction-rules>
